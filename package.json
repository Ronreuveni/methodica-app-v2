{
  "name": "methodica-app-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Methodica studio production board — Supabase-backed, multi-user, real-time",
  "scripts": {
    "dev": "vite",
    "server": "node --experimental-sqlite server/index.mjs",
    "local": "node scripts/dev-local.mjs",
    "build": "vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "supabase:gen-types": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^6.0.0"
  }
}
