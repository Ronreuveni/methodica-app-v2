# ─── Supabase configuration ───────────────────────────────────────────────
# 1. Create a new project at https://supabase.com/dashboard
# 2. Project Settings → API → copy these two values:

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# ─── Owner email (for migrations + initial bootstrap) ─────────────────────
# Used as the first allowed user when running the seed script.
# Add more users via the in-app settings panel or directly in the
# `allowed_emails` table.

VITE_OWNER_EMAIL=ronr@methodic.co.il
